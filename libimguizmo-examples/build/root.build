# Uncomment to suppress warnings coming from external libraries.
#
cxx.internal.scope = current

# Apple SDK headers currently reject C++23/26 enum arithmetic.
#
using cxx.guess
cxx.std = ($cxx.target.class == 'macos' ? 20 : latest)

using cxx

hxx{*}: extension = h
cxx{*}: extension = cpp

# Interactive desktop demo. Do not run it from b test / bdep test.
#
exe{*}: test = false
