# Uncomment to suppress warnings coming from external libraries.
#
cxx.internal.scope = current

# Upstream CMake uses C++17. latest is C++26 here and rejects enum
# arithmetic in the Apple SDK headers pulled in by ImApp.h / Carbon.h.
#
cxx.std = 17

using cxx

hxx{*}: extension = h
cxx{*}: extension = cpp

# Interactive desktop demo. Do not run it from b test / bdep test.
#
exe{*}: test = false
